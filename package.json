{
  "name": "postcss-scope-import",
  "description": "PostCSS Scope Import",
  "repository": "postcss/postcss-plugin-boilerplate",
  "version": "3.0.1",
  "license": "MIT",
  "bin": "cli.js",
  "keywords": [
    "postcss",
    "boilerplate"
  ],
  "scripts": {
    "test": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "gogen": "^2.3.0"
  },
  "peerDependencies": {
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "clean-publish": "^4.4.0",
    "eslint": "^9.33.0",
    "vitest": "^3.2.4"
  },
  "eslintConfig": {
    "parserOptions": {
      "ecmaVersion": 2017
    },
    "env": {
      "node": true,
      "es6": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "rules": {
      "no-unused-vars": "off"
    }
  },
  "prettier": {
    "arrowParens": "avoid",
    "jsxSingleQuote": false,
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  }
}
